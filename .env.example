# Luna — environment variables
# Copy this file to ".env" for local running, or set these in Render:
#   Luna-app service -> Environment -> Add Environment Variable

# Port the server listens on (Render sets this automatically)
PORT=3000

# Public address of the site (used for Stripe return links)
# Example on Render: https://luna-app-m3av.onrender.com
BASE_URL=http://localhost:3000

# --- Database (Postgres) ---
# REQUIRED. Luna stores all user data in Postgres; it refuses to start
# without this. Get the value from Neon: project -> Connect -> copy the
# connection string. Paste it here (locally) or in Render:
#   Luna-app service -> Environment -> Add Environment Variable
# Never share it in chat or commit a real value.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- AI readings ---
# Get this from https://console.anthropic.com (API Keys). Keep it SECRET.
# Without it, Luna runs in demo mode with canned sample readings.
ANTHROPIC_API_KEY=

# Which Claude model Luna uses
CLAUDE_MODEL=claude-sonnet-5-5

# Let Luna look up the current sky (moon phases, retrogrades) during readings
ENABLE_WEB_SEARCH=true

# --- Payments (Stripe) ---# From https://dashboard.stripe.com (Developers -> API keys). Keep SECRET.
# Without it, billing runs in dev mode: checkouts grant time instantly, free.
STRIPE_SECRET_KEY=

# From Stripe after you add the webhook endpoint:
#   Developers -> Webhooks -> Add endpoint
#   URL: <BASE_URL>/api/stripe/webhook
#   Events: checkout.session.completed, invoice.paid, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# --- Pricing (defaults shown) ---
TRIAL_MINUTES=3
PRICE_PER_MINUTE_CENTS=99
SUBSCRIPTION_PRICE_CENTS=1999
SUBSCRIPTION_MINUTES=100

# --- Email (password-reset emails only) ---
# Resend (free tier): https://resend.com — create an account, verify a
# sender address or domain, then copy the API key. Keep it SECRET.
# Without it, password-reset requests fail gracefully with a clear error
# and everything else keeps working. No other part of Luna sends email.
RESEND_API_KEY=
# Verified sender shown on reset emails. For testing, Resend's onboarding
# address only delivers to the Resend account owner's own address.
EMAIL_FROM=Luna <onboarding@resend.dev>
